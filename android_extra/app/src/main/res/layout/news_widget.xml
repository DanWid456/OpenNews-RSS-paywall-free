<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/news_widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:text="@string/news_widget_title"
        android:textColor="@color/news_widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/news_widget_divider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/news_widget_empty"
        android:textColor="@color/news_widget_meta"
        android:textSize="13sp" />
</LinearLayout>
